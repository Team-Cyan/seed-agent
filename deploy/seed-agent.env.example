# Pin one verified immutable image for BOTH roles before starting Compose.
# This placeholder intentionally cannot be pulled until replaced.
SEED_AGENT_IMAGE=ghcr.io/team-cyan/seed-agent@sha256:REPLACE_WITH_VERIFIED_DIGEST
SEED_AGENT_IMAGE_DIGEST=sha256:REPLACE_WITH_VERIFIED_DIGEST

# Optional. When set, Web UI write/search/enqueue POST requests must include
# X-Seed-Agent-Token or Authorization: Bearer with this value. Leave empty for
# the default trusted-local behavior.
# SEED_AGENT_WEB_TOKEN=change-me

# For the two-role Compose example, pin the SAME immutable image for both roles.
# Replace these values after verifying the published image digest.
# SEED_AGENT_IMAGE=ghcr.io/team-cyan/seed-agent@sha256:<verified-digest>
# SEED_AGENT_IMAGE_DIGEST=sha256:<verified-digest>
MEDIA_PARENT_DIR=/srv/media
# Replace this generic common-parent example before deploying.
